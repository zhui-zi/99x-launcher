{
  "name": "99x-launcher",
  "version": "1.3.2",
  "description": "99x launcher — WinUI 3 & Fluent 2 CS2 Community Server Launcher (EXG / ZED / FYS)",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && npm run build:electron && electron . --dev\"",
    "dev:web": "vite",
    "build:electron": "esbuild electron/main.ts --bundle --platform=node --external:electron --outfile=dist-electron/main.js --format=cjs && esbuild electron/preload.ts --bundle --platform=node --external:electron --outfile=dist-electron/preload.js --format=cjs",
    "build": "vite build && npm run build:electron",
    "pack:exe": "npm run build && electron-builder --win portable --config electron-builder.json && node scripts/cleanup-release.cjs",
    "start": "npm run build && electron ."
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "recharts": "^2.13.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.24.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wait-on": "^8.0.1"
  }
}
